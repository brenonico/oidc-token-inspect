{
  "name": "@oidc-token-inspect/browser",
  "version": "0.1.0",
  "description": "Drop-in browser plugin for Token Inspect. Self-mounts a DevTools-style panel in a closed Shadow DOM. Includes ClientObserver (fetch and XHR pass-through wrap), PKCE flow reconstruction, traceparent correlation (same-origin allowlist).",
  "keywords": [
    "oidc",
    "oauth",
    "jwt",
    "devtools",
    "pkce",
    "drop-in",
    "browser",
    "token",
    "auth"
  ],
  "license": "MIT",
  "author": "Breno Nico",
  "homepage": "https://github.com/brenonico/oidc-token-inspect#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/brenonico/oidc-token-inspect.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/brenonico/oidc-token-inspect/issues"
  },
  "type": "module",
  "main": "dist/token-inspect.umd.cjs",
  "module": "dist/token-inspect.es.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "vite build && node scripts/postbuild-sri.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@oidc-token-inspect/core": "^0.1.0",
    "@oidc-token-inspect/react": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
